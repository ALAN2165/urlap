      (70, 'Public Relations', NULL, 2700),
      (80, 'Marketing',        NULL, 1800);
  `);

  console.log('✅ SQL playground ready: 29 employees, 7 departments, read-only grants, sandbox schema privileges.');
  await admin.end();
}

main().catch((err) => {
