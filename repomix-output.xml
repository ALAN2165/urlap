import { CheckCircle2, Trophy } from 'lucide-react';

// تعريف نوع الـ Challenge محلياً لضمان عدم حدوث أي أخطاء في الـ Build
interface Challenge {
  id: string | number;
  slug: string;
  titleAr: string;
  titleEn: string;
  difficulty: 'EASY' | 'MEDIUM' | 'HARD' | 'EXPERT';
  solved?: boolean;
  points: number;
  category: {
    nameAr: string;
