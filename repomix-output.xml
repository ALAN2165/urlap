.scroll-thin::-webkit-scrollbar-thumb { background: rgba(168, 85, 247, 0.4); border-radius: 9999px; }

html[dir='rtl'] body { font-family: var(--font-arabic), sans-serif !important; }

.bg-mesh { position: relative; }
.bg-mesh::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 25% 15%, rgba(168, 85, 247, 0.10), transparent 45%),
    radial-gradient(circle at 80% 75%, rgba(139, 92, 246, 0.10), transparent 50%);
