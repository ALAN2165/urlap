@tailwind components;
@tailwind utilities;

:root {
  --font-sans: 'Playfair Display', serif;
  --font-arabic: 'Alexandria', sans-serif;
}

* { scroll-behavior: smooth; }
::-webkit-scrollbar { display: none; }
html { scrollbar-width: none; -ms-overflow-style: none; }

.scroll-thin { scrollbar-width: thin; scrollbar-color: rgba(168, 85, 247, 0.4) transparent; }
