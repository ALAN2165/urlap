<file path="backend/src/controllers/inbox.controller.ts">
import { Response, NextFunction } from 'express';
import { AuthRequest } from '../middleware/authMiddleware';
import { prisma } from '../config/db';

/** Unread = a message in one of MY conversations, not sent by me, with no readAt yet. */
export async function getMyInboxUnreadCount(req: AuthRequest, res: Response, next: NextFunction) {
  try {
    const userId = req.userId!;
    const groups = await prisma.message.groupBy({
      by: ['conversationId'],
      where: { readAt: null, senderId: { not: userId }, conversation: { userId } },
      _count: { _all: true },
    });

    const byConversation: Record<string, number> = {};
    let count = 0;
    for (const g of groups) {
      byConversation[g.conversationId] = g._count._all;
      count += g._count._all;
    }

    res.setHeader('Cache-Control', 'no-store');
    res.json({ count, byConversation });
  } catch (err) { next(err); }
}

/** Marks every message in one of the user's own conversations (not sent by them) as read. */
export async function markConversationRead(req: AuthRequest, res: Response, next: NextFunction) {
  try {
    const id = req.params.id as string;
    const userId = req.userId!;
    const conversation = await prisma.conversation.findUniqueOrThrow({ where: { id }, select: { userId: true } });
    if (conversation.userId !== userId) return res.status(403).json({ error: 'Forbidden' });

    const result = await prisma.message.updateMany({
      where: { conversationId: id, readAt: null, senderId: { not: userId } },
      data: { readAt: new Date() },
    });
    res.setHeader('Cache-Control', 'no-store');
    res.json({ marked: result.count });
  } catch (err) { next(err); }
}
</file>

<file path="backend/src/controllers/submission.controller.ts">
import { Response, NextFunction } from 'express';
import { AuthRequest } from '../middleware/authMiddleware';
import { submissionSchema } from '../validators/submission.validator';
import { prisma } from '../config/db';
import { isChallengeLocked } from '../services/labProgress.service';
import { gradeSubmissionById } from '../services/submissionGrading.service';

export async function createSubmission(req: AuthRequest, res: Response, next: NextFunction) {
  try {
    const { challengeId, language, code, isPasted, timeSpentSeconds, tabSwitches } = submissionSchema.parse(req.body);

    const locked = await isChallengeLocked(challengeId, req.userId);
    if (locked) return res.status(403).json({ error: 'This challenge is locked. Solve the previous challenge first.' });

    const submission = await prisma.submission.create({
      data: {
        userId: req.userId!, challengeId, language, code, status: 'PENDING',
        isPasted: isPasted ?? false, timeSpentSeconds: timeSpentSeconds ?? null, tabSwitches: tabSwitches ?? 0,
      },
    });

    if (language === 'SQL') {
      // Graded right here by the transactional sandbox engine: no Redis, no queue, no worker, no Docker.
      await gradeSubmissionById(submission.id);
      const done = await prisma.submission.findUniqueOrThrow({ where: { id: submission.id }, select: { status: true } });
      return res.status(200).json({ submissionId: submission.id, status: done.status });
    }

    const { enqueueExecution } = await import('../queues/executionQueue');
    await enqueueExecution({ submissionId: submission.id, challengeId, userId: req.userId!, language, code });
    res.status(202).json({ submissionId: submission.id, status: 'PENDING' });
  } catch (err) { next(err); }
}

interface StoredResult {
  columns?: string[]; rows?: unknown[][]; totalRows?: number; expectedRowCount?: number | null;
  failureReason?: string | null; panels?: unknown[];
  award?: { base: number; penalty: number; net: number; firstSolve: boolean } | null;
}

export async function getSubmission(req: AuthRequest, res: Response, next: NextFunction) {
  try {
    const submission = await prisma.submission.findUniqueOrThrow({ where: { id: req.params.id as string } });
    if (submission.userId !== req.userId) return res.status(403).json({ error: 'Forbidden' });

    const { resultJson, code, ...rest } = submission;
    let parsed: StoredResult = {};
    if (resultJson) { try { parsed = JSON.parse(resultJson); } catch { parsed = {}; } }

    res.json({
      ...rest,
      resultColumns: parsed.columns ?? [],
      resultRows: parsed.rows ?? [],
      totalRows: parsed.totalRows ?? 0,
      expectedRowCount: parsed.expectedRowCount ?? null,
      failureReason: parsed.failureReason ?? null,
      comparison: submission.status === 'WRONG_ANSWER' ? parsed.panels ?? [] : [],
      award: parsed.award ?? null,
    });
  } catch (err) { next(err); }
}
</file>

<file path="backend/src/services/labProgress.service.ts">
import { prisma } from '../config/db';

export interface ChallengeAccess { hidden: boolean; locked: boolean; isBoss: boolean }
interface OrderedChallenge { id: string; isMaster: boolean }

/**
 * `ordered` = a lab's challenges sorted by orderIndex.
 *  - Regular challenges unlock one after another (masters don't take part in that chain).
 *  - A Master Challenge is HIDDEN until every regular challenge before it is solved.
 */
export function computeAccess(ordered: OrderedChallenge[], solved: Set<string>): Map<string, ChallengeAccess> {
  const regular = ordered.filter((c) => !c.isMaster);
  const map = new Map<string, ChallengeAccess>();

  ordered.forEach((c, i) => {
    if (c.isMaster) {
      const hidden = !ordered.slice(0, i).filter((p) => !p.isMaster).every((p) => solved.has(p.id));
      map.set(c.id, { hidden, locked: false, isBoss: true });
      return;
    }
    const pos = regular.findIndex((r) => r.id === c.id);
    map.set(c.id, { hidden: false, locked: pos > 0 && !solved.has(regular[pos - 1].id), isBoss: false });
  });
  return map;
}

export async function getChallengeAccess(challengeId: string, userId?: string): Promise<ChallengeAccess> {
  const ch = await prisma.challenge.findUniqueOrThrow({ where: { id: challengeId }, select: { labId: true } });
  if (!ch.labId) return { hidden: false, locked: false, isBoss: false };

  const ordered = await prisma.challenge.findMany({
    where: { labId: ch.labId },
    orderBy: { orderIndex: 'asc' },
    select: { id: true, isMaster: true },
  });
  const done = userId
    ? await prisma.challengeCompletion.findMany({ where: { userId, challengeId: { in: ordered.map((o) => o.id) } }, select: { challengeId: true } })
    : [];
  return computeAccess(ordered, new Set(done.map((d) => d.challengeId))).get(challengeId) as ChallengeAccess;
}

/** True when the challenge is locked OR still hidden (a hidden Master Challenge can't be submitted to). */
export async function isChallengeLocked(challengeId: string, userId?: string): Promise<boolean> {
  const a = await getChallengeAccess(challengeId, userId);
  return a.hidden || a.locked;
}

/** Number of challenges a student can currently see (hidden Master Challenges aren't counted). */
export async function countVisibleChallenges(userId: string): Promise<number> {
  const [all, done] = await Promise.all([
    prisma.challenge.findMany({ orderBy: [{ labId: 'asc' }, { orderIndex: 'asc' }], select: { id: true, labId: true, isMaster: true } }),
    prisma.challengeCompletion.findMany({ where: { userId }, select: { challengeId: true } }),
  ]);
  const solved = new Set(done.map((d) => d.challengeId));
  const byLab = new Map<string, OrderedChallenge[]>();
  let visible = 0;

  for (const c of all) {
    if (!c.labId) { visible++; continue; }
    const list = byLab.get(c.labId) || [];
    list.push({ id: c.id, isMaster: c.isMaster });
    byLab.set(c.labId, list);
  }
  byLab.forEach((list) => {
    const access = computeAccess(list, solved);
    list.forEach((c) => { if (!(access.get(c.id) as ChallengeAccess).hidden) visible++; });
  });
  return visible;
}
</file>

