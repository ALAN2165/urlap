generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum Language {
  SQL
  JAVASCRIPT
  PYTHON
  TYPESCRIPT
  JAVA
  CPP
  CSHARP
  GO
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  COMPILE_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
}

enum AnnouncementType {
  INFO
  NEW_LAB
  FEATURE
  MAINTENANCE
}

enum Role {
  STUDENT
  ADMIN
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id                        String   @id @default(cuid())
  username                  String   @unique
  email                     String   @unique
  passwordHash              String
  avatarUrl                 String?  @db.Text
  totalPoints               Int      @default(0)
  preferredLang             String   @default("en")
  showInLeaderboard         Boolean  @default(true)
  receiveAnnouncementEmails Boolean  @default(false)
  role                      Role     @default(STUDENT)
  isBanned                  Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  submissions      Submission[]
  solvedChallenges ChallengeCompletion[]
  hintUsages       HintUsage[]
  resetTokens      PasswordResetToken[]
  challengeReports ChallengeReport[]
  inboxMessages    InboxMessage[]

  conversationsAsUser  Conversation[] @relation("ConversationsAsUser")
  conversationsAsAdmin Conversation[] @relation("ConversationsAsAdmin")
  messages             Message[]
  alerts               Alert[]        @relation("AlertsForUser")

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Lab {
  id         String      @id @default(cuid())
  slug       String      @unique
  titleEn    String
  titleAr    String
  orderIndex Int         @default(0)
  challenges Challenge[]
  createdAt  DateTime    @default(now())

  @@map("labs")
}

model Category {
  id         String      @id @default(cuid())
  nameEn     String
  nameAr     String
  slug       String      @unique
  icon       String?
  challenges Challenge[]

  @@map("categories")
}

model Challenge {
  id              String     @id @default(cuid())
  slug            String     @unique
  titleEn         String
  titleAr         String
  descriptionEn   String     @db.Text
  descriptionAr   String     @db.Text
  difficulty      Difficulty
  points          Int        @default(100)
  timeLimitMs     Int        @default(5000)
  memoryLimitMb   Int        @default(128)
  orderIndex      Int        @default(0)

  schemaJson      String?    @db.Text
  referenceAnswer String?    @db.Text

  labId      String?
  lab        Lab?      @relation(fields: [labId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  starterCodes  StarterCode[]
  testCases     TestCase[]
  hints         Hint[]
  submissions   Submission[]
  completions   ChallengeCompletion[]
  reports       ChallengeReport[]
  alerts        Alert[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("challenges")
}

model StarterCode {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  language    Language
  code        String    @db.Text

  @@unique([challengeId, language])
  @@map("starter_codes")
}

model TestCase {
  id             String    @id @default(cuid())
  challengeId    String
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  input          String    @db.Text
  expectedOutput String    @db.Text
  isHidden       Boolean   @default(false)
  orderIndex     Int       @default(0)

  @@map("test_cases")
}

model Hint {
  id           String    @id @default(cuid())
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  order        Int
  contentEn    String    @db.Text
  contentAr    String    @db.Text
  pointPenalty Int       @default(10)

  usages HintUsage[]

  @@unique([challengeId, order])
  @@map("hints")
}

model HintUsage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hintId     String
  hint       Hint     @relation(fields: [hintId], references: [id], onDelete: Cascade)
  revealedAt DateTime @default(now())

  @@unique([userId, hintId])
  @@map("hint_usages")
}

model Submission {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId   String
  challenge     Challenge        @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  language      Language
  code          String           @db.Text
  status        SubmissionStatus @default(PENDING)
  actualOutput  String?          @db.Text
  errorMessage  String?          @db.Text
  resultJson    String?          @db.Text
  runtimeMs     Int?
  memoryKb      Int?
  pointsAwarded Int              @default(0)

  isPasted         Boolean @default(false)
  timeSpentSeconds Int?
  tabSwitches      Int     @default(0)

  createdAt DateTime @default(now())

  @@map("submissions")
}

model ChallengeCompletion {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId  String
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  pointsEarned Int
  completedAt  DateTime  @default(now())

  @@unique([userId, challengeId])
  @@map("challenge_completions")
}

model Announcement {
  id        String           @id @default(cuid())
  titleEn   String
  titleAr   String
  contentEn String           @db.Text
  contentAr String           @db.Text
  type      AnnouncementType @default(INFO)
  createdAt DateTime         @default(now())

  @@map("announcements")
}

model ChallengeReport {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reason      String    @db.Text
  createdAt   DateTime  @default(now())

  replies InboxMessage[]

  @@map("challenge_reports")
}

model Conversation {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation("ConversationsAsUser", fields: [userId], references: [id], onDelete: Cascade)
  adminId     String?
  admin       User?              @relation("ConversationsAsAdmin", fields: [adminId], references: [id])
  challengeId String?
  challenge   Challenge?         @relation(fields: [challengeId], references: [id])
  status      ConversationStatus @default(OPEN)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  messages Message[]
  alerts   Alert[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@map("messages")
}

model Alert {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("AlertsForUser", fields: [userId], references: [id], onDelete: Cascade)
  challengeId    String
  challenge      Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  reason         String
  failCount      Int           @default(0)
  status         AlertStatus   @default(OPEN)
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  @@map("alerts")
}

model InboxMessage {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderLabel     String           @default("Support Team") // never the real admin username — privacy by design
  subject         String
  body            String           @db.Text
  relatedReportId String?
  relatedReport   ChallengeReport? @relation(fields: [relatedReportId], references: [id], onDelete: SetNull)
  read            Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@map("inbox_messages")
}